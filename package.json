{
  "name": "bento",
  "version": "0.1.0",
  "private": true,
  "description": "A folder-backed Markdown workspace for notes, projects, and todos",
  "main": "desktop/main.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:desktop": "install-electron",
    "start": "electron .",
    "test": "node --test prototype/tests/workspace.js tests/*.test.js",
    "test:browser": "node prototype/tests/workflow.js",
    "test:desktop": "node tests/desktop.js",
    "package": "node scripts/package.js",
    "demo": "node scripts/serve.js"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "@electron/packager": "20.3.0",
    "playwright": "1.64.1"
  },
  "type": "module"
}
