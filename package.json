{
  "name": "bento",
  "version": "0.1.0",
  "private": true,
  "description": "A folder-backed Markdown workspace for notes, projects, and todos",
  "main": "desktop/main.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "setup:desktop": "install-electron",
    "start": "node scripts/build-editor.js && electron .",
    "lint": "eslint . --max-warnings 0 && markdownlint-cli2",
    "test": "node --test prototype/tests/workspace.js tests/*.test.js",
    "test:browser": "node scripts/build-editor.js && node prototype/tests/workflow.js",
    "test:desktop": "node scripts/build-editor.js && node tests/desktop.js && node tests/desktop.js --sidebar && node tests/desktop.js --properties && node tests/desktop.js --micro",
    "test:desktop:micro": "node scripts/build-editor.js && node tests/desktop.js --micro",
    "test:desktop:properties": "node scripts/build-editor.js && node tests/desktop.js --properties",
    "test:desktop:sidebar": "node scripts/build-editor.js && node tests/desktop.js --sidebar",
    "package": "node scripts/package.js",
    "demo": "node scripts/build-editor.js && node scripts/serve.js",
    "build": "node scripts/build-editor.js",
    "assets:icons": "node scripts/build-icons.js"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "electron": "44.9.0",
    "entities": "8.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.23.3",
    "playwright": "1.64.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.6"
  },
  "type": "module"
}
