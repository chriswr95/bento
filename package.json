{
  "name": "bento",
  "version": "0.1.0",
  "private": true,
  "description": "A folder-backed Markdown workspace for notes, projects, and todos",
  "main": "desktop/main.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:desktop": "install-electron",
    "start": "node scripts/build-editor.js && electron .",
    "test": "node --test prototype/tests/workspace.js tests/*.test.js",
    "test:browser": "node scripts/build-editor.js && node prototype/tests/workflow.js",
    "test:desktop": "node scripts/build-editor.js && node tests/desktop.js",
    "package": "node scripts/package.js",
    "demo": "node scripts/build-editor.js && node scripts/serve.js",
    "build": "node scripts/build-editor.js"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.9.0",
    "entities": "8.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.6"
  },
  "type": "module"
}
